<text id="ID_s2_txt01"><![CDATA[<table border="0" cellpadding="0" cellspacing="0" width="392"> <tr> <td colspan="2">R1#<strong>tampilkan rute ipv6 statis</strong></td> </tr> <tr> <td colspan="2">Tabel Perutean IPv6 - default - 4 entri</td> </tr> <tr> <td width="43">Kode:</td> <td width="346">C - Terhubung, L - Lokal, S - Statis,</td> </tr> <tr> <td> </td> <td>U - Rute statis per pengguna</td> </tr> <tr> <td> </td> <td>B - BGP, R - RIP, I1 - ISIS L1, I2 - ISIS L2</td> </tr> <tr> <td> </td> <td>IA - ISIS interarea, IS - ringkasan ISIS, D - EIGRP,</td> </tr> <tr> <td> </td> <td>EX - EIGRP eksternal</td> </tr> <tr> <td> </td> <td>ND - ND Default, NDp - Awalan ND, DCE - Tujuan,</td> </tr> <tr> <td> </td> <td>NDr - Pengalihan</td> </tr> <tr> <td> </td> <td>O - OSPF Intra, OI - OSPF Inter, OE1 - OSPF ext 1,</td> </tr> <tr> <td> </td> <td>OE2 - OSPF ekst 2</td> </tr> <tr> <td> </td> <td>ON1 - OSPF NSSA ekst 1, ON2 - OSPF NSSA ekst 2</td> </tr> <tr> <td bgcolor="#FACCA8" class="bg_trans" colspan="2">S 2001:DB8:ACAD::/61 [1/0]<br/><span>melalui 2001:DB8:PAKAN:1::2</span></td></tr> <tr> <td>R1#</td> <td> </td> </tr></table>
