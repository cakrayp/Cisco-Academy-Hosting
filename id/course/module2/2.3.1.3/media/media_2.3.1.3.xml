<component id="ID_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" class="mtable" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#98D3D1" class="mtitle" colspan="2"><font color="#0E6360" size="12"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr class="mtable_top">
<td bgcolor="#0E6360" class="mtable_top" colspan="2"><font color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Masuk ke mode konfigurasi global.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1# <b class="command">konfigurasikan terminal</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Masuk ke mode konfigurasi antarmuka.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config)# <b class="command">antarmuka FastEthernet 0/1</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Konfigurasikan dupleks antarmuka.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b class="command">dupleks penuh</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Konfigurasikan kecepatan antarmuka.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config-if)# <b class="command">kecepatan 100</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Kembali ke mode EXEC istimewa.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b class="command">akhir</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Simpan konfigurasi yang berjalan ke konfigurasi startup.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b class="command">salin menjalankan-config startup-config</b></font></td>
</tr>
</table>]]></text>
</component>




