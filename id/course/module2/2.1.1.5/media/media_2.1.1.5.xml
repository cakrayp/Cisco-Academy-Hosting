<textcomponents>

<component id="ID_s1_title">
<text><![CDATA[<b>Konfigurasikan Antarmuka Manajemen Pengalihan</b>]]></text>
</component>

<component id="ID_s1_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#98D3D1" class="title" colspan="2"><font color="#393536" size="12"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr>
<td bgcolor="#0E6360" class="mtable_top" colspan="2"><font color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top" width="160">Masuk ke mode konfigurasi global.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1# <b>konfigurasikan terminal</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Masuk ke mode konfigurasi antarmuka untuk SVI.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config)# <b>antarmuka vlan 99</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Konfigurasikan alamat IP antarmuka manajemen.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b>alamat ip 172.17.99.11 255.255.0.0</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Aktifkan antarmuka manajemen.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config-if)# <b>tidak ada penutupan</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Kembali ke mode EXEC istimewa.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b>akhir</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Simpan konfigurasi yang berjalan ke konfigurasi startup.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b>salin menjalankan-config startup-config</b></font></td>
</tr>
</table>]]></text>
</component>


<component id="ID_s2_title">
<text><![CDATA[<b>Konfigurasikan Switch Default Gateway</b>]]></text>
</component>

<component id="ID_s2_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#98D3D1" class="title" colspan="2"><font color="#393536" size="12"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr>
<td bgcolor="#0E6360" class="mtable_top" colspan="2"><font color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top" width="160">Masuk ke mode konfigurasi global.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1# <b>konfigurasikan terminal</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Konfigurasikan gateway default untuk sakelar.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config)# <b>ip gateway default 172.17.99.1</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Kembali ke mode EXEC istimewa.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b>akhir</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Simpan konfigurasi yang berjalan ke konfigurasi startup.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b>salin menjalankan-config startup-config</b></font></td>
</tr>
</table>]]></text>
</component>

