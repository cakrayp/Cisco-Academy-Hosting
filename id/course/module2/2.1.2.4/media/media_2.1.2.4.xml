<component id="ID_s1_title">
<text><![CDATA[<b>Perintah Verifikasi</b>]]></text>
</component>

<component id="ID_s1_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" class="mtable" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr class="mtitle">
<td bgcolor="#98D3D1" class="mtitle" colspan="2"><font class="font11px" color="#393536" size="12"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr>
<td bgcolor="#0E6360" class="mtable_top" colspan="2"><font color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Menampilkan status dan konfigurasi antarmuka.</td>
<td bgcolor="#EFF8F7" valign="top" width="260"><font face="_typewriter">S1# <b class="command">tampilkan antarmuka</b> [<i>antarmuka-id</i>]</font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Tampilkan konfigurasi startup saat ini.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b class="command">tampilkan startup-config</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Tampilkan konfigurasi pengoperasian saat ini.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter"> S1# <b class="command">tampilkan konfigurasi yang sedang berjalan</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Menampilkan informasi tentang sistem file flash.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b class="command">tampilkan kilat</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Menampilkan status perangkat keras dan perangkat lunak sistem.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter"> S1# <b class="command">versi pertunjukan</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Menampilkan riwayat perintah yang dimasukkan.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1# <b class="command">menunjukkan sejarah</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top">Menampilkan informasi IP tentang antarmuka.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">  S1# <b class="command">tampilkan IP</b>[<i>antarmuka-id</i>]</font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top">Menampilkan tabel alamat MAC.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter"> S1# <b class="command">tampilkan tabel-alamat-mac</b></font><br/>OR<br/><font face="_typewriter"> S1# <b class="command">tampilkan tabel alamat mac</b></font></td>
</tr>
</table>]]></text>
</component>





