<!--Slide 2-->
<component id="ID_s2_title">
<text><![CDATA[<b></b>]]></text>
</component>

<component id="ID_s2_SC01" fontFace='Courier New' fontSize="10">
		<feedback id="fb"><![CDATA[<b><font size = '10' class="font10px" face="Arial" color="#0000FF">***You must enter the exact and full command. Commands that include a name or password are case-sensitive.***</font></b>
		]]></feedback>
		
		<existingcommands><![CDATA[<font  face="Arial"><b>Enter configuration mode and set FastEthernet0/1 duplex to full and speed 100.</b></font>]]></existingcommands>
		<command prompt="S1#">
		    <correctresponse><![CDATA[configure terminal]]></correctresponse>
				<deviceresponse><![CDATA[<font Face='Courier New' Size="10" class="font10px">Enter configuration commands, one per line.  End with CNTL/Z.</font>]]></deviceresponse> 					
		</command>
		<command prompt="S1(config)#">
			<correctresponse><![CDATA[interface FastEthernet0/1]]></correctresponse>
		</command>
		<command prompt="S1(config-if)#">
			<correctresponse><![CDATA[duplex full]]></correctresponse>
		</command>
		<command prompt="S1(config-if)#">
			<correctresponse><![CDATA[speed 100]]></correctresponse>
			<instruction><![CDATA[<font face="Arial"><b>End out of configuration mode and save the configuration to NVRAM.</b></font>]]></instruction>
		</command>
		<command prompt="S1(config-if)#">
			<correctresponse><![CDATA[end]]></correctresponse>
				<deviceresponse><![CDATA[<font Face='Courier New' Size="10" class="font10px">S1#<br>%SYS-5-CONFIG_I: Configured from console by console</font>]]></deviceresponse> 					
		</command>
		<command prompt="S1#">
			<correctresponse><![CDATA[copy running-config startup-config]]></correctresponse>
			<instruction><![CDATA[<font  face="Arial"><b>You successfully configured the switch port duplex and speed settings.</b></font>]]></instruction>
		</command>
		<command prompt=""/>
	</component>


</textcomponents>