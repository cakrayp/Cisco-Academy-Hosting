<component id="ID_title">
<text><![CDATA[<b>LSU Berisi LSA</b>]]></text>
</component>

<component id="ID_Title_txt01">
<text><![CDATA[<b></b>]]></text>
</component>

<component id="ID_Body_txt01">
<text><![CDATA[<textformat blockindent="-14"><li>LSU berisi satu atau lebih LSA.</li><li>LSA berisi informasi rute untuk jaringan tujuan.</li></textformat>]]></text>
</component>

<component id="ID_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" class="mtable" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000" style="width:450px;">
<tr class="mtable_top">
<td bgcolor="#0E6360" class="mtable_top" colspan="3"><font color="#434321" size="1"><span style="color:#DAE17A">.</span></font></td>
</tr>
<tr>
<td bgcolor="#077A77" class="mtitle" valign="top" width="40"><font color="#ffffff"><b>Jenis</b></font></td>
<td bgcolor="#077A77" class="mtitle" valign="top" width="90"><font color="#ffffff"><b>Nama Paket</b></font></td>
<td bgcolor="#077A77" class="mtitle" valign="top"><font color="#ffffff"><b>Keterangan</b></font></td>
</tr>
<tr>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">1</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Hello</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Discovers neighbors and builds adjacencies between them</font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top"><font color="#393536">2</font></td>
<td bgcolor="#ffffff" valign="top"><font color="#393536">DBD</font></td>
<td bgcolor="#ffffff" valign="top"><font color="#393536">Checks for database synchronization between routers</font></td>
</tr>
<tr>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">3</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">LSR</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Requests specific link-state records from router to router</font></td>
</tr>
<tr>
<td bgcolor="#FACCA8" valign="top"><font color="#393536">4</font></td>
<td bgcolor="#FACCA8" valign="top"><font color="#393536">LSU</font></td>
<td bgcolor="#FACCA8" valign="top"><font color="#393536">Sends specifically requested link-state records</font></td>
</tr>
<tr>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">5</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">LSAck</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Acknowledges the other packet types</font></td>
</tr>
</table>]]></text> 
