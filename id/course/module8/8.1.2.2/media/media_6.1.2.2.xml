<text><![CDATA[<b>Deskripsi Paket OSPF</b>]]></text>
</component>

<!--Table-->
<component id="ID_table">
  <text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#0E6360" class="liner_top" colspan="3"><font color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#077A77" valign="top" width="50"><font color="#ffffff" size="11"><b>Jenis</b></font></td>
<td bgcolor="#077A77" valign="top"><font color="#ffffff" size="11"><b>Nama Paket</b></font></td>
<td bgcolor="#077A77" valign="top"><font color="#ffffff" size="11"><b>Keterangan</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">1</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Hello</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Discovers neighbors and builds adjacencies between them</font></td>
</tr>
<tr>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">2</font></td>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">Database Description (DBD)</font></td>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">Checks for database synchronization between routers</font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">3</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Link-State Request (LSR)</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Requests specific link-state records from router to router</font></td>
</tr>
<tr>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">4</font></td>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">Link-State Update (LSU)</font></td>
<td bgcolor="#FFFFFF" valign="top"><font color="#393536">Sends specifically requested link-state records</font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">5</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Link-State Acknowledgment (LSAck)</font></td>
<td bgcolor="#EFF8F7" valign="top"><font color="#393536">Acknowledges the other packet types</font></td>
</tr>
</table>]]></text>
