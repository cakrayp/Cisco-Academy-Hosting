<component id="ID_s2_title">
<text><![CDATA[<b>Langkah Konfigurasi PAT</b>]]></text>
</component>

<!--screen 2 table -->
<component id="ID_s2_table">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" cellspacing="2" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr class="mtable_top">
<td bgcolor="#0E6360" colspan="2"><font class="mtable_top" color="#434321" size="1"><span style="color:#DAE17A">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" width="80"><b>Langkah 1</b></td>
<td bgcolor="#EFF8F7">Tentukan daftar akses standar yang mengizinkan alamat yang harus diterjemahkan.<br/><br/><font face="_typewriter"><b>daftar akses</b><i>nomor daftar akses</i><b>izin</b> <i>sumber</i>[<i>sumber-wildcard</i>]</font></td>
</tr>
<tr>
<td bgcolor="#FFFFFF"><b>Langkah 2</b></td>
<td bgcolor="#FFFFFF">Tetapkan terjemahan sumber dinamis, temukan ACL, antarmuka keluar, dan opsi kelebihan beban.<br/><br/><font face="_typewriter"><b>ip nat di dalam daftar sumber</b> <i>nomor daftar akses</i><b>antarmuka</b><i>ketik nomor</i><b>kelebihan muatan</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7"><b>Langkah 3</b></td>
<td bgcolor="#EFF8F7">pengenalan antarmuka bagian dalam.<br/><br/><font face="_typewriter"><b>antarmuka</b><i>ketik nomor</i><br/><b>ip nat di dalam</b></font></td>
</tr>
<tr>
<td bgcolor="#FFFFFF"><b>Langkah 4</b></td>
<td bgcolor="#FFFFFF">pengenalan antarmuka luar.<br/><br/><font face="_typewriter"><b>antarmuka</b><i>ketik nomor</i><br/><b>ip nat di luar</b></font></td>
</tr>
</table>]]></text>
</component>


