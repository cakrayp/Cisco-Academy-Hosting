<component id="ID_s2_title">
<text><![CDATA[<b>Mengonfigurasi NAT Statis</b>]]></text>
</component>
  
<!--screen 2 table -->
<component id="ID_s2_table">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" cellspacing="2" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr class="mtable_top">
<td bgcolor="#0E6360" class="mtable_top" colspan="3"><font color="#434321" size="1"><span style="color:#DAE17A">.</span></font></td>
</tr>
<tr>
<td bgcolor="#077A77" valign="top" width="40"><font bgcolor="#097A76" color="#EFF8F7"><b>Melangkah</b></font></td>
<td bgcolor="#077A77" valign="top"><font bgcolor="#097A76" color="#EFF8F7"><b>Tindakan</b></font></td>
<td bgcolor="#077A77" valign="top"><font bgcolor="#097A76" color="#EFF8F7"><b>Catatan</b></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7">1</td>
<td bgcolor="#EFF8F7">Buat terjemahan statistik antara alamat lokal dalam dan alamat global dalam.<font face="_typewriter"><br/>Router(config)# <b>ip nat di dalam sumber statistik</b><i>ip-lokal global-ip</i></font></td>
<td bgcolor="#EFF8F7">Masukkan<font face="_typewriter"><b>tidak ada ip nat di dalam sumber statistik</b></font>perintah mode konfigurasi global untuk menghapus terjemahan sumber dinamis.</td>
</tr>
<tr>
<td bgcolor="#FFFFFF">2</td>
<td bgcolor="#FFFFFF">Tentukan antarmuka bagian dalam.<br/> <font face="_typewriter">Router(config)# <b>antarmuka</b><i>ketik nomor</i></font></td>
<td bgcolor="#FFFFFF">Masukkan<font face="_typewriter"><b>antarmuka</b></font>memerintah. Perintah CLI berubah dari<font face="_typewriter">(config)# </font>to <font face="_typewriter">(config-if)#</font>.</td>
</tr>
<tr>
<td bgcolor="#EFF8F7">3</td>
<td bgcolor="#EFF8F7">Tandai antarmuka sebagai terhubung ke dalam.<br/> <font face="_typewriter">Router(config-if)# <b>ip nat di dalam</b></font></td>
<td bgcolor="#EFF8F7"> </td>
</tr>
<tr>
<td bgcolor="#FFFFFF">4</td>
<td bgcolor="#FFFFFF">Keluar dari mode konfigurasi antarmuka.<br/> <font face="_typewriter">Router(config-if)# <b>KELUAR</b></font></td>
<td bgcolor="#FFFFFF"> </td>
</tr>
<tr>
<td bgcolor="#FFFFFF">5</td>
<td bgcolor="#FFFFFF">Tentukan antarmuka luar.<br/> <font face="_typewriter">Router(config)# <b>antarmuka</b><i>ketik nomor</i></font></td>
<td bgcolor="#FFFFFF"> </td>
</tr>
<tr>
<td bgcolor="#EFF8F7">6</td>
<td bgcolor="#EFF8F7">Tandai antarmuka sebagai terhubung ke luar.<br/><font face="_typewriter">Router(config-if)# <b>ip nat di luar</b></font></td>
<td bgcolor="#EFF8F7"> </td>
</tr>
</table>]]></text>
</component>


