R1(config-dhcpv6)# <b>dns-server 2001:db8:cafe:aaaa::5</b>
R1(config-dhcpv6)# <b>contoh nama domain.com</b>
R1(config-dhcpv6)# <b>KELUAR</b>
R1(config)# <b>antarmuka g0/1</b>
R1(config-if)# <b>alamat ipv6 2001:db8:cafe:1::1/64</b>
R1(config-if)# <b>server dhcp ipv6 IPV6-STATEFUL</b>
