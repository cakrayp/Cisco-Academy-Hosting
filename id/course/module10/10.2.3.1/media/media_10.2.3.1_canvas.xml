	<text id="ID_router_txt2"><![CDATA[<pre>Router(config-dhcpv6)# <b>alamat</b><span class="new1">awalan/panjang</span> [<b>seumur hidup</b>
                       <span class="new1">valid-seumur hidup disukai-seumur hidup</span>
                       | <b>tak terbatas</b>]         
Router(config-dhcpv6)# <span class="new"><b>server dns</b></span><span class="new1">alamat-server-dns</span>
Router(config-dhcpv6)# <span class="new"><b>nama domain</b></span><span class="new1">nama domain</span></pre>]]></text>
	<text id="ID_router_txt3"><![CDATA[<pre>Router(config)# <b>antarmuka</b> <span class="new1">ketik nomor</span>
