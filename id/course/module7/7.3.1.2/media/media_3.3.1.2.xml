		    <correctresponse><![CDATA[network 192.168.4.0]]></correctresponse>
			<instruction><![CDATA[<font face="Arial"><b>You are now logged into R3. Advertise the RIP networks for R3. Start with the lowest IP network.</b>]]></instruction>			
			</command>
