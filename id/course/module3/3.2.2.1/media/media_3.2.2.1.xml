<component id="ID_s1_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#98D3D1" class="mtitle" colspan="2"><font color="#393536" size="12"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr class="mtable_top">
<td bgcolor="#0E6360" colspan="2"><font class="mtable_top" color="#0E6360" size="1"><span style="color:#98D3D1">.</span></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top" width="150">Masuk ke mode konfigurasi global.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1# <b>konfigurasikan terminal</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top" width="150">Masuk ke mode konfigurasi antarmuka untuk SVI.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config)# <b>antarmuka</b><i>antarmuka_id</i></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top" width="150">Paksa tautan tersebut menjadi tautan utama.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b>bagasi mode switchport</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top" width="150">Tentukan VLAN asli untuk trunk 802.1Q yang tidak diberi tag.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config-if)# <b>vlan asli trunk switchport</b><i>vlan_id</i></font></td>
</tr>
<tr>
<td bgcolor="#EFF8F7" valign="top" width="150">Tentukan daftar VLAN yang diizinkan pada link trunk.</td>
<td bgcolor="#EFF8F7" valign="top"><font face="_typewriter">S1(config-if)# <b>trunk switchport mengizinkan vlan</b><i>daftar vlan</i></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top" width="150">Kembali ke mode EXEC istimewa.</td>
<td bgcolor="#ffffff" valign="top"><font face="_typewriter">S1(config-if)# <b>akhir</b></font></td>
</tr>
</table>]]></text>
