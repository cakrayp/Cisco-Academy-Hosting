<component id="ID_table01">
<text><![CDATA[<table bordercolor="#98D3D1" borderwidth="3" cellpadding="4" glow="true" glowcolor="#808080" header="none" shadow="false" shadowcolor="#000000">
<tr>
<td bgcolor="#98D3D1" class="mtitle" colspan="2"><font color="#1C3635" size="11"><b>Cisco Beralih Perintah IOS</b></font></td>
</tr>
<tr class="mtable_top">
<td bgcolor="#0E6360" class="mtable_top" colspan="2"><font color="#434321" size="1"><span style="color:#DAE17A">.</span></font></td>
</tr>
<tr>
<td bgcolor="#077A77" valign="top" width="160"><font color="#ffffff"><b></b></font></td>
<td bgcolor="#077A77" valign="top" width="260"><font color="#ffffff"><b></b></font></td>
</tr>
<tr>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Enter global configuration mode.</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536" face="_typewriter">S1# <b>konfigurasikan terminal</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top"><font color="#393536">Enter interface configuration mode for the SVI.</font></td>
<td bgcolor="#ffffff" valign="top"><font color="#393536" face="_typewriter">S1(config)# <i>antarmuka antarmuka_id</i></font></td>
</tr>
<tr>
<td bgcolor="#eff8f7" valign="top"><font color="#393536">Set trunk to allow all VLANs.</font></td>
<td bgcolor="#eff8f7" valign="top"><font color="#393536" face="_typewriter">S1(config-if)# <b>tidak ada trunk switchport yang mengizinkan vlan</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top"><font color="#393536">Reset native VLAN to default.</font></td>
<td bgcolor="#ffffff" valign="top"><font color="#393536" face="_typewriter">S1(config-if)# <b>tidak ada vlan asli trunk switchport</b></font></td>
</tr>
<tr>
<td bgcolor="#ffffff" valign="top"><font color="#393536">Return to the privileged EXEC mode.</font></td>
<td bgcolor="#ffffff" valign="top"><font color="#393536" face="_typewriter">S1(config-if)# <b>akhir</b></font></td>
</tr>
</table>]]></text> 
